{
    "manifest_version": 3,
    "name": "Kenowa AI Assistant",
    "version": "2.18",
    "description": "Your premium AI companion for the web.",
    "permissions": [
        "sidePanel",
        "storage",
        "offscreen",
        "activeTab",
        "scripting",
        "tabs",
        "alarms",
        "contextMenus"
    ],
    "host_permissions": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://ollama.com/*",
        "https://html.duckduckgo.com/*",
        "<all_urls>",
        "https://api.github.com/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://api.github.com https://generativelanguage.googleapis.com https://openrouter.ai https://ollama.com https://html.duckduckgo.com;"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "utils.js",
                "selection.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "action": {
        "default_title": "Open Kenowa AI"
    },
    "commands": {
        "_execute_side_panel": {
            "suggested_key": {
                "default": "Ctrl+Shift+K",
                "mac": "Command+Shift+K"
            },
            "description": "Open the AI Side Panel"
        }
    }
}